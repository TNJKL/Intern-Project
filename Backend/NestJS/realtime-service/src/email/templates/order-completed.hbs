<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brewtra Coffee - Đơn hàng giao thành công</title>
  <style>
    @media only screen and (max-width: 599px) {
      .col-main {
        width: 100% !important;
        max-width: 100% !important;
        margin-bottom: 25px !important;
      }
      .col-sidebar {
        width: 100% !important;
        max-width: 100% !important;
      }
      .body-padding {
        padding: 20px 15px 25px 15px !important;
      }
      .hero-img {
        max-height: none !important;
      }
    }
  </style>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f6f6f6; margin: 0; padding: 40px 10px; color: #3c2a21;">
  <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 650px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #e2d8cf; overflow: hidden;">
    
    <!-- HEADER BAR -->
    <tr>
      <td style="padding: 20px 30px; border-bottom: 1px solid #eef2f5;">
        <table width="100%" border="0" cellpadding="0" cellspacing="0">
          <tr>
            <!-- Left Logo -->
            <td valign="middle">
              <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color: #8c6239; border-radius: 50%; width: 32px; height: 32px; text-align: center; color: #ffffff; font-weight: bold; font-size: 18px; line-height: 32px;">B</td>
                  <td style="padding-left: 10px; font-size: 20px; font-weight: bold; color: #2b1b17; letter-spacing: 0.5px; font-family: 'Georgia', serif;">Brewtra Coffee</td>
                </tr>
              </table>
            </td>
            <!-- Right Navigation -->
            <td align="right" valign="middle" style="font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
              <a href="http://localhost:3000" style="color: #8c6239; text-decoration: none;">Trang chủ</a>
              <span style="color: #ccc; padding: 0 8px;">|</span>
              <a href="http://localhost:3000/menu" style="color: #8c6239; text-decoration: none;">Thực đơn</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- BIG NEWSLETTER TITLE -->
    <tr>
      <td align="center" style="padding: 25px 30px 15px 30px;">
        <span style="font-size: 11px; font-weight: 800; letter-spacing: 3px; color: #a28970; text-transform: uppercase; display: block; margin-bottom: 5px;">Hành trình đơn hàng</span>
        <h1 style="margin: 0; font-family: 'Georgia', serif; font-size: 28px; font-weight: bold; color: #2b1b17; letter-spacing: 1px; text-transform: uppercase;">Giao thành công</h1>
        <div style="width: 60px; height: 2px; background-color: #8c6239; margin-top: 15px;"></div>
      </td>
    </tr>

    <!-- HERO IMAGE BANNER -->
    <tr>
      <td style="padding: 10px 30px 25px 30px;">
        <img class="hero-img" src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&auto=format&fit=crop&q=80" alt="Brewtra Delivered Coffee" width="100%" style="display: block; border-radius: 8px; border: 1px solid #e2d8cf; max-height: 220px; object-fit: cover;" />
      </td>
    </tr>

    <!-- TWO COLUMN CONTENT WORKSPACE -->
    <tr>
      <td class="body-padding" style="padding: 10px 30px 35px 30px;">
        <!--[if mso]>
        <table width="100%" border="0" cellpadding="0" cellspacing="0">
        <tr>
        <td width="370" valign="top">
        <![endif]-->
        
        <!-- LEFT COLUMN (Main Story) -->
        <table align="left" border="0" cellpadding="0" cellspacing="0" class="col-main" style="width: 100%; max-width: 370px; margin-bottom: 20px;">
          <tr>
            <td valign="top">
              <h2 style="font-family: 'Georgia', serif; font-size: 18px; color: #2b1b17; margin: 0 0 10px 0;">Chào {{customerName}},</h2>
              <p style="font-size: 13.5px; color: #666; line-height: 1.6; margin: 0 0 20px 0;">Đơn hàng của bạn đã được giao thành công! Chúng tôi rất vui mừng được đem đến cho bạn những ly đồ uống thơm ngon và giàu năng lượng cho ngày hôm nay.</p>
              
              <!-- Thank you text box -->
              <div style="background-color: #faf6f0; border-left: 4px solid #8c6239; border-radius: 0 8px 8px 0; padding: 16px 20px; margin: 20px 0; color: #55413c; font-size: 13.5px; line-height: 1.5; font-weight: 600;">
                ☕ Hy vọng bạn sẽ hài lòng với hương vị đặc biệt này. Mọi ý kiến phản hồi xin vui lòng gửi về hòm thư hỗ trợ của cửa hàng.
              </div>

              <p style="font-size: 13.5px; color: #666; line-height: 1.6; margin-bottom: 20px;">Để đặt hàng tiếp theo, quý khách có thể truy cập trực tiếp menu của chúng tôi:</p>
              <a href="http://localhost:3000/menu" style="display: inline-block; background-color: #8c6239; color: #ffffff; padding: 12px 25px; border-radius: 6px; font-size: 13px; font-weight: bold; text-decoration: none; text-transform: uppercase; letter-spacing: 1px;">Xem Thực Đơn</a>
            </td>
          </tr>
        </table>
        
        <!--[if mso]>
        </td>
        <td width="20"></td>
        <td width="200" valign="top">
        <![endif]-->

        <!-- RIGHT COLUMN (Sidebar) -->
        <table align="right" border="0" cellpadding="0" cellspacing="0" class="col-sidebar" style="width: 100%; max-width: 200px; background-color: #faf6f0; border: 1px solid #efe8de; border-radius: 8px; padding: 18px 14px; text-align: center;">
          <tr>
            <td valign="top">
              <!-- STATUS BADGE -->
              <span style="display: inline-block; background-color: #8c6239; color: #ffffff; padding: 4px 10px; border-radius: 4px; font-size: 9px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px;">Đã hoàn thành</span>
              
              <!-- Sidebar Image -->
              <img src="https://images.unsplash.com/photo-1507133750040-4a8f57021571?w=150&auto=format&fit=crop&q=80" alt="Espresso Cup" width="100%" style="display: block; border-radius: 4px; margin-bottom: 12px; border: 1px solid #efe8de;" />
              
              <!-- Sidebar Header -->
              <h4 style="font-family: 'Georgia', serif; font-size: 12.5px; color: #2b1b17; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px;">Mã đơn hàng</h4>
              
              <!-- Order Code text -->
              <p style="font-size: 13.5px; font-weight: bold; color: #8c6239; margin: 0 0 16px 0; word-break: break-all;">#{{orderCode}}</p>
              
              <div style="border-top: 1px solid #efe8de; margin-bottom: 12px; padding-top: 12px;">
                <h4 style="font-family: 'Georgia', serif; font-size: 11.5px; color: #2b1b17; margin: 0 0 5px 0; text-transform: uppercase; letter-spacing: 0.5px;">Thành viên</h4>
                {{#if isGuest}}
                <p style="font-size: 11px; color: #777; line-height: 1.4; margin: 0 0 12px 0;">Đăng ký tài khoản để bắt đầu tích lũy chi tiêu và thăng hạng thành viên!</p>
                {{else}}
                <p style="font-size: 11px; color: #777; line-height: 1.4; margin: 0 0 12px 0;">Tiếp tục đặt hàng để tích điểm thăng hạng và nhận ưu đãi độc quyền!</p>
                {{/if}}
                <a href="http://localhost:3000" style="display: inline-block; background-color: #2b1b17; color: #ffffff; padding: 8px 12px; border-radius: 4px; font-size: 10px; font-weight: bold; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;">Ghé cửa hàng</a>
              </div>
            </td>
          </tr>
        </table>
        
        <!--[if mso]>
        </td>
        </tr>
        </table>
        <![endif]-->
      </td>
    </tr>

    <!-- FOOTER SIGNATURE -->
    <tr>
      <td style="padding: 25px 30px; background-color: #faf6f0; border-top: 1px solid #efe8de; text-align: center; font-size: 12px; color: #88746e;">
        <p style="margin: 0 0 6px 0; font-weight: bold; color: #2b1b17; text-transform: uppercase; letter-spacing: 1px;">Brewtra Coffee Shop</p>
        <p style="margin: 0 0 16px 0;">Liên hệ: support@brewtra.coffee | Hotline: 1900-xxxx</p>
        <p style="margin: 0; font-size: 10px; color: #a08c87; border-top: 1px solid #efe8de; padding-top: 16px; line-height: 1.5;">Email này được gửi tự động từ hệ thống của Brewtra. Vui lòng không trả lời email này.</p>
      </td>
    </tr>

  </table>
</body>
</html>

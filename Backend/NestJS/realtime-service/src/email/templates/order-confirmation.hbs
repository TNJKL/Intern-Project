<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Brewtra Coffee - Xác nhận đơn hàng</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f6f6f6; margin: 0; padding: 40px 10px; color: #3c2a21;">
  <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 650px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #e2d8cf; overflow: hidden;">
    
    <!-- HEADER BAR -->
    <tr>
      <td style="padding: 20px 30px; border-bottom: 1px solid #eef2f5;">
        <table width="100%" border="0" cellpadding="0" cellspacing="0">
          <tr>
            <!-- Left Logo -->
            <td valign="middle">
              <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color: #8c6239; border-radius: 50%; width: 32px; height: 32px; text-align: center; color: #ffffff; font-weight: bold; font-size: 18px; line-height: 32px;">B</td>
                  <td style="padding-left: 10px; font-size: 20px; font-weight: bold; color: #2b1b17; letter-spacing: 0.5px; font-family: 'Georgia', serif;">Brewtra Coffee</td>
                </tr>
              </table>
            </td>
            <!-- Right Navigation -->
            <td align="right" valign="middle" style="font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
              <a href="http://localhost:3000" style="color: #8c6239; text-decoration: none;">Trang chủ</a>
              <span style="color: #ccc; padding: 0 8px;">|</span>
              <a href="http://localhost:3000/menu" style="color: #8c6239; text-decoration: none;">Thực đơn</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- BIG NEWSLETTER TITLE -->
    <tr>
      <td align="center" style="padding: 25px 30px 15px 30px;">
        <span style="font-size: 11px; font-weight: 800; letter-spacing: 3px; color: #a28970; text-transform: uppercase; display: block; margin-bottom: 5px;">Hệ thống xác nhận</span>
        <h1 style="margin: 0; font-family: 'Georgia', serif; font-size: 28px; font-weight: bold; color: #2b1b17; letter-spacing: 1px; text-transform: uppercase;">Xác nhận đặt hàng</h1>
        <div style="width: 60px; height: 2px; background-color: #8c6239; margin-top: 15px;"></div>
      </td>
    </tr>

    <!-- HERO IMAGE BANNER -->
    <tr>
      <td style="padding: 10px 30px 25px 30px;">
        <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&auto=format&fit=crop&q=80" alt="Brewtra Coffee Table" width="100%" style="display: block; border-radius: 8px; border: 1px solid #e2d8cf; max-height: 220px; object-fit: cover;" />
      </td>
    </tr>

    <!-- TWO COLUMN CONTENT WORKSPACE -->
    <tr>
      <td style="padding: 10px 30px 35px 30px;">
        <table width="100%" border="0" cellpadding="0" cellspacing="0">
          <tr>
            <!-- LEFT COLUMN (Main Story / Bill details) -->
            <td width="64%" valign="top">
              <h2 style="font-family: 'Georgia', serif; font-size: 18px; color: #2b1b17; margin: 0 0 10px 0;">Chào {{customerName}},</h2>
              <p style="font-size: 13.5px; color: #666; line-height: 1.6; margin: 0 0 20px 0;">Cảm ơn bạn đã lựa chọn và đặt hàng tại Brewtra! Các Barista đang bắt đầu chuẩn bị ly đồ uống của bạn và đơn hàng sẽ được vận chuyển tới bạn trong thời gian sớm nhất.</p>
              
              <!-- Bill detail header -->
              <h3 style="font-family: 'Arial', 'Helvetica', sans-serif; font-size: 13px; font-weight: bold; letter-spacing: 0.5px; color: #2b1b17; margin: 25px 0 10px 0; border-bottom: 2px solid #8c6239; padding-bottom: 6px;">CHI TIẾT ĐƠN HÀNG</h3>
              
              <!-- Items list -->
              <table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 13px;">
                {{#if items}}
                  {{#each items}}
                  <tr style="border-bottom: 1px solid #eef2f5;">
                    <td style="padding: 12px 0; color: #4a3525; font-weight: bold; width: 75%;" valign="top">
                      <span>{{productName}} {{#if variantLabel}}({{variantLabel}}){{/if}}</span>
                      <span style="color: #8c6239; margin-left: 6px; font-weight: bold;">x{{quantity}}</span>
                      {{#if toppings}}
                        <div style="font-size: 11px; color: #777; font-weight: normal; margin-top: 4px; padding-left: 8px; border-left: 2px solid #efe8de; line-height: 1.4;">
                          {{#each toppings}}
                            <div style="margin-bottom: 2px;">
                              + Topping: {{name}} (+{{unitPrice}})
                            </div>
                          {{/each}}
                        </div>
                      {{/if}}
                    </td>
                    <td style="padding: 12px 0; text-align: right; font-weight: bold; color: #2b1b17; width: 25%;" valign="top">
                      {{subtotal}}
                    </td>
                  </tr>
                  {{/each}}
                {{else}}
                  {{#each orderDetails}}
                  <tr style="border-bottom: 1px solid #eef2f5;">
                    <td style="padding: 12px 0; color: #4a3525; font-weight: bold;">
                      {{this}}
                    </td>
                  </tr>
                  {{/each}}
                {{/if}}
              </table>

              <!-- Total pay -->
              <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-top: 15px; border-top: 1px solid #eef2f5; padding-top: 12px;">
                {{#if discountAmount}}
                <tr>
                  <td align="right" style="color: #666; font-size: 13px; padding-bottom: 6px;">Giảm giá:</td>
                  <td align="right" style="font-size: 14px; font-weight: bold; color: #d9534f; width: 45%; padding-bottom: 6px;">-{{discountAmount}}</td>
                </tr>
                {{/if}}
                {{#if totalAmount}}
                <tr>
                  <td align="right" style="color: #666; font-size: 13px;">Tổng thanh toán:</td>
                  <td align="right" style="font-size: 18px; font-weight: bold; color: #8c6239; width: 45%;">{{totalAmount}}</td>
                </tr>
                {{/if}}
              </table>
            </td>

            <!-- GAP DIVIDER -->
            <td width="5%"></td>

            <!-- RIGHT COLUMN (Sidebar with green/beige background) -->
            <td width="31%" valign="top" style="background-color: #faf6f0; border: 1px solid #efe8de; border-radius: 8px; padding: 18px 14px; text-align: center;">
              
              <!-- BUY HERE / STATUS BADGE -->
              <span style="display: inline-block; background-color: #8c6239; color: #ffffff; padding: 4px 10px; border-radius: 4px; font-size: 9px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px;">Đã xác nhận</span>
              
              <!-- Sidebar Image -->
              <img src="https://images.unsplash.com/photo-1507133750040-4a8f57021571?w=150&auto=format&fit=crop&q=80" alt="Espresso Cup" width="100%" style="display: block; border-radius: 4px; margin-bottom: 12px; border: 1px solid #efe8de;" />
              
              <!-- Sidebar Header -->
              <h4 style="font-family: 'Georgia', serif; font-size: 12.5px; color: #2b1b17; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px;">Mã đơn hàng</h4>
              
              <!-- Order Code text -->
              <p style="font-size: 13.5px; font-weight: bold; color: #8c6239; margin: 0 0 16px 0; word-break: break-all;">#{{orderCode}}</p>
              
              <div style="border-top: 1px solid #efe8de; margin-bottom: 12px; padding-top: 12px;">
                <h4 style="font-family: 'Georgia', serif; font-size: 11.5px; color: #2b1b17; margin: 0 0 5px 0; text-transform: uppercase; letter-spacing: 0.5px;">Thành viên</h4>
                <p style="font-size: 11px; color: #777; line-height: 1.4; margin: 0 0 12px 0;">Đăng ký để tích điểm thăng hạng nhận nhiều quà tặng và ưu đãi hấp dẫn!</p>
                <a href="http://localhost:3000" style="display: inline-block; background-color: #2b1b17; color: #ffffff; padding: 8px 12px; border-radius: 4px; font-size: 10px; font-weight: bold; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;">Khám phá ngay</a>
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- FOOTER SIGNATURE -->
    <tr>
      <td style="padding: 25px 30px; background-color: #faf6f0; border-top: 1px solid #efe8de; text-align: center; font-size: 12px; color: #88746e;">
        <p style="margin: 0 0 6px 0; font-weight: bold; color: #2b1b17; text-transform: uppercase; letter-spacing: 1px;">Brewtra Coffee Shop</p>
        <p style="margin: 0 0 16px 0;">Liên hệ: support@brewtra.coffee | Hotline: 1900-xxxx</p>
        <p style="margin: 0; font-size: 10px; color: #a08c87; border-top: 1px solid #efe8de; padding-top: 16px; line-height: 1.5;">Email này được gửi tự động từ hệ thống của Brewtra. Vui lòng không trả lời email này.</p>
      </td>
    </tr>

  </table>
</body>
</html>

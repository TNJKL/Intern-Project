# Copy thành .env và điền giá trị. Không commit .env.
#
# product-service đã cấu hình: spring.config.import: optional:file:.env
# → Spring đọc file .env cùng thư mục làm việc (working directory) khi khởi động.
# IntelliJ / VS Code: đặt Working directory = thư mục module product-service (nơi có file .env).
#
# Nếu không dùng file: vẫn có thể set biến môi trường OS, EnvFile plugin, hoặc Run Configuration.

# Bật module S3 (false thì không có bean upload, endpoint /api/v1/storage/images không tồn tại)
BEVERAGE_STORAGE_S3_ENABLED=true

# Tên bucket (chữ thường, không khoảng trắng) — lấy ở AWS Console → S3 → Buckets → General purpose buckets → tên cột "Name"
AWS_S3_BUCKET=ten-bucket-cua-ban

# Region bucket — lấy ở trang chi tiết bucket (ví dụ ap-southeast-1)
AWS_REGION=ap-southeast-1

# Tiền tố object key trên S3 (không slash đầu/cuối). Tự đặt: beverage/dev, beverage/prod, ...
AWS_S3_KEY_PREFIX=beverage/dev

# (Tuỳ chọn) Nếu dùng CloudFront/CDN — base URL không slash cuối. Để trống thì API trả URL S3 virtual-hosted.
# AWS_S3_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net

# Access key IAM — tạo ở IAM → Users → Security credentials → Create access key (Application running outside AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

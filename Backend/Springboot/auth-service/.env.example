# Sao chép file này thành `.env` (không push Git). Hai biến đầu bắt buộc khi dev local.

POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_BASE64_HMAC_SECRET

SERVER_PORT=8081
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=16384

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auth_db
POSTGRES_USER=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

JWT_ACCESS_TOKEN_EXPIRATION=600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,https://*.ngrok-free.app,https://*.ngrok-free.dev

# HTTPS / ngrok: đặt true; HTTP local: false (hoặc bỏ dòng để dùng default trong application.yml)
AUTH_ACCESS_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
